includes:
  - %rootDir%/../../happyprime/coding-standards/phpstan.neon.dist

parameters:
  level: 9
  ignoreErrors:
    # `build/index.asset.php` is generated by wp-scripts, so its shape is only
    # known at build time. The include is guarded by an is_array() check.
    -
      identifier: argument.type
      path: plugin.php
      count: 2
    # `$wp_admin_bar->user->blogs` holds get_blogs_of_user() objects, which
    # PHPStan only knows as stdClass.
    -
      identifier: property.notFound
      path: plugin.php
      count: 1
